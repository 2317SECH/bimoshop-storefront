# Storefront BIMO Shop -- proyecto independiente del backend (dashboard/core/
# agents). Este .env es propio, se configura en Vercel como variables de
# entorno del proyecto, no se comparte con el .env del VPS.

# Dominio de la tienda Shopify (mismo valor que SHOPIFY_STORE_DOMAIN del
# backend -- es el mismo store, dos APIs distintas).
SHOPIFY_STORE_DOMAIN=

# Token de la Storefront API (publico de solo lectura de catalogo/carrito --
# NO es el mismo tipo de credencial que SHOPIFY_CLIENT_ID/SECRET del backend,
# que son de la Admin API. Generar en: Shopify Admin > Configuracion > Apps y
# canales de venta > Desarrollar apps > (crear o abrir la app BIMO) >
# API de Storefront > Configurar > activar scopes de lectura de
# productos/colecciones/carrito > Instalar app > copiar el
# "Storefront API access token" de ahi.
SHOPIFY_STOREFRONT_API_TOKEN=

SHOPIFY_STOREFRONT_API_VERSION=2026-07

# URL publica de BIMO Core (VPS) -- usada solo server-side por
# app/api/waitlist/route.ts para reenviar el alta a POST /waitlist sin
# exponer esta URL ni CORS al browser. Ej: https://api.bimoshop.com
CORE_API_URL=
